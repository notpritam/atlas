      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-notifications",
      "./plugins/withFoundkeepShareExtension.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 92,
          "dark": {
            "backgroundColor": "#19161F"
          }
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "33362145-2b45-4d86-bb08-cd10c6bfae61",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "FoundkeepShare",
                  "bundleIdentifier": "app.foundkeep.ios.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.foundkeep.ios"
                    ],
                    "keychain-access-groups": [
                      "$(AppIdentifierPrefix)app.foundkeep.shared"
                    ]
                  }
