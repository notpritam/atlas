{
  "expo": {
    "name": "FoundKeep",
    "slug": "foundkeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foundkeep",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/33362145-2b45-4d86-bb08-cd10c6bfae61"
    },
    "ios": {
      "bundleIdentifier": "app.foundkeep.ios",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:foundkeep.app"
      ],
      "usesAppleSignIn": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.foundkeep.ios"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)app.foundkeep.shared"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "FoundkeepKeychainAccessGroup": "$(AppIdentifierPrefix)app.foundkeep.shared"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "1C8F.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
