{
  "name": "atlas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas floating capture companion — a draggable dock that grabs region screenshots, the current selection/clipboard, and quick notes straight into your Atlas.",
  "main": "src/main.js",
  "author": "notpritam",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.notpritam.atlas.desktop",
    "productName": "Atlas",
    "files": ["src/**/*", "assets/**/*"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"] }
  }
}
