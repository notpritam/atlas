{
  "manifest_version": 3,
  "name": "FoundKeep — Save what matters",
  "version": "1.7.5",
  "description": "Save readable pages, screenshots, highlights, images and notes with original source details in a private, searchable library.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://foundkeep.app/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FoundKeep",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "src/twitter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://foundkeep.app/*",
      "https://atlas.notpritam.in/*"
    ]
  },
  "commands": {
    "region-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Screenshot a region to FoundKeep"
    },
    "full-page-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Full-page screenshot to FoundKeep"
    },
    "save-highlight": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Save the selected text to FoundKeep"
    }
  },
  "key": "",
  "update_url": "https://github.com/notpritam/foundkeep/releases/latest/download/updates.xml",
  "optional_permissions": [
    "bookmarks"
  ],
  "side_panel": {
    "default_path": "src/library.html"
  }
}
