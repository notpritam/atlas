{
  "name": "atlas-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend": "bun run --cwd apps/backend dev",
    "test": "bun test",
    "release": "node deploy/release-extension.mjs",
    "release:publish": "node deploy/release-extension.mjs --publish",
    "test:extension": "node --test tests/extension-ui.mjs tests/extension-smoke.mjs tests/extension-action.mjs tests/extension-cloud.mjs tests/extension-db.mjs tests/extension-extractor.mjs tests/extension-preferences.mjs tests/extension-policy.mjs tests/extension-store.mjs tests/bookmark-import.mjs tests/library-api.mjs tests/extension-library.mjs tests/extension-environments.mjs tests/extension-environments-browser.mjs tests/extension-collections.mjs",
    "store:pack": "bash deploy/pack-store.sh",
    "store:verify": "node --test tests/extension-store.mjs",
    "store:assets": "node scripts/render-store-assets.mjs",
    "store:kit": "bash deploy/pack-store-submission.sh",
    "test:web": "node --test tests/landing-smoke.mjs",
    "test:customer": "node --test tests/customer-flow.mjs tests/customer-web.mjs",
    "prepare:web-assets": "node scripts/prepare-web-assets.mjs",
    "brand:assets": "node scripts/render-brand-assets.mjs",
    "mobile:start": "npm --workspace @foundkeep/mobile run start",
    "mobile:test": "npm --workspace @foundkeep/mobile run test",
    "mobile:typecheck": "npm --workspace @foundkeep/mobile run typecheck",
    "mobile:prebuild": "npm --workspace @foundkeep/mobile run prebuild",
    "extension:build:dev": "node deploy/build-extension.mjs --environment dev",
    "extension:build:prod": "node deploy/build-extension.mjs --environment prod",
    "dev:seed": "node scripts/seed-dev.mjs"
  },
  "devDependencies": {
    "crx3": "^2.0.0",
    "playwright-core": "1.62.1"
  }
}
