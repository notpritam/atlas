[Unit]
Description=Atlas server-side enrichment worker (drains the capture queue via Claude Code)
Documentation=https://github.com/notpritam/atlas
After=network.target atlas-backend.service

[Service]
Type=simple
User=pritam
WorkingDirectory=/home/pritam/personal/apps/atlas/apps/backend
Environment=ATLAS_DATA_DIR=/home/pritam/.local/share/atlas
Environment=ATLAS_MODEL=claude-haiku-4-5-20251001
# needs `claude` (Claude Code, its own auth — no API key) + bun on PATH
Environment=PATH=/home/pritam/.local/bin:/home/pritam/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pritam/.bun/bin/bun run bin/enrich.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
